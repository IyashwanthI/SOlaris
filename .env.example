# Copy to .env and fill in real values. Do NOT commit the real .env.

# Required — Google AI Studio / Gemini API key (embeddings + co-pilot).
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional — secret used to sign JWT auth tokens.
# Falls back to a dev default if omitted; set a long random value in production.
JWT_SECRET=change-this-to-a-long-random-string
